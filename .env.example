# Nothing is required here for normal use! WatchKlyp authorizes through a
# shared Twitch application (Public client, PKCE — no secret exists), so you
# don't need to register your own Twitch dev app or set a Client ID/Secret.
# Just run the server, open the page it launches, and enter your channel
# name there — it's saved to config.json, not here.
#
# This file only matters if you want to override defaults:

# Only set this if you're deliberately running your OWN Twitch application
# instead of the shared WatchKlyp one (must be a Public client type, PKCE).
# TWITCH_CLIENT_ID=

# Local server settings — defaults are almost always fine to leave alone.
PORT=3939

# Twitch requires an https:// redirect URL (even for localhost), so the
# OAuth callback runs on its own small HTTPS listener with a self-signed
# cert generated automatically on first run.
AUTH_PORT=3940
